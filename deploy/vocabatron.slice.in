[Unit]
Description=Vocabatron low priority resource boundary

[Slice]
CPUAccounting=yes
CPUWeight=idle
CPUQuota=200%
CPUQuotaPeriodSec=100ms
MemoryAccounting=yes
MemoryHigh=6G
MemoryMax=8G
MemorySwapMax=0
MemoryLow=0
MemoryMin=0
IOAccounting=yes
IOWeight=1
IOReadBandwidthMax=@BLOCK_DEVICE@ 20M
IOWriteBandwidthMax=@BLOCK_DEVICE@ 10M
TasksMax=160
